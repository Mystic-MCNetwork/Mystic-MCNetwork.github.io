        <TextBlock TextWrapping="Wrap" Margin="20,5,20,5"
                    Text="我们对造成的不便感到抱歉。 Orz" />
    </StackPanel>
</local:MyCard>

<local:MyCard Title="公告 2026/7/12" Margin="0,0,0,15" CanSwap="true" IsSwapped="false">
    <StackPanel Margin="25,40,23,15">
        <TextBlock TextWrapping="Wrap" Margin="20,5,20,5"
