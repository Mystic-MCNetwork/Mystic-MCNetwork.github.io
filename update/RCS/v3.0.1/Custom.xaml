                    Text="服务器地址如下：" />
        <TextBlock TextWrapping="Wrap" Margin="30,0,20,0"
                    Text="Java 版 (MC 26.2) - mysticnetwork.top" />
        <TextBlock TextWrapping="Wrap" Margin="0,10,20,0"
                    Text="白名单申请 / 玩家交流QQ群: 793789863" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,20,5"
